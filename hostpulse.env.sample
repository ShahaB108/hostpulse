# HostPulse configuration
#
# Copy this file to hostpulse.env (same directory as hostpulse.py) and edit
# the values for this server.
#
# Variable substitution: $VAR and ${VAR} are expanded against the real OS
# environment when this file is loaded (via os.path.expandvars). This is
# NOT a shell -- no command execution, no globs, just plain variable
# substitution. So HOSTPULSE_SERVER_NAME=$HOSTNAME below works correctly
# as long as $HOSTNAME is actually set in the environment this script runs
# under (cron and systemd often do NOT export HOSTNAME by default -- check
# with `echo $HOSTNAME` in the exact context this runs, or just leave
# HOSTPULSE_SERVER_NAME empty to fall back to os.uname().nodename, which
# always works without depending on any shell env var).
#
# Real OS environment variables always override values set in this file.
# To point at a different env file entirely, set HOSTPULSE_ENV_FILE as a
# real OS env var before running hostpulse.py.
#
# Every threshold/weight variable name below must match THRESHOLD_SPEC /
# WEIGHT_ENV_NAMES in hostpulse.py exactly -- both now live in one table
# in the code, so if you add a new metric, add its row there first.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Leave empty to use the system hostname automatically (recommended).
HOSTPULSE_SERVER_NAME=$HOSTNAME
HOSTPULSE_LOG_LEVEL=INFO
HOSTPULSE_LOG_FILE=/opt/hostpulse/logs/hostpulse.log

# ---------------------------------------------------------------------------
# Output files
# ---------------------------------------------------------------------------
HOSTPULSE_JSON_OUTPUT=/var/www/html/sdkfpwensdks/output/users.json
# Leave empty to disable Prometheus textfile output. Point this at
# node_exporter's textfile collector directory to feed Grafana directly,
# e.g. /var/lib/node_exporter/textfile_collector/hostpulse.prom
HOSTPULSE_PROM_OUTPUT=

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
# Verify this matches your CloudLinux version's lveinfo syntax before
# relying on it -- run `lveinfo --help` on the target server. --json is
# preferred (more reliable, structured parsing) and the collector falls
# back automatically to text-table parsing if --json isn't supported or
# the output isn't valid JSON, so leaving --json on is safe either way.
HOSTPULSE_LVEINFO_COMMAND=lveinfo --period=1d --by-fault any -d --show-all --json
# Column order must stay user,pcpu,pmem,rss,pid -- live_stats.py parses
# positionally, not by column name. Change both together if you touch this.
HOSTPULSE_PS_COMMAND=ps -eo user=,pcpu=,pmem=,rss=,pid=

# Maximum seconds to wait for any single collector command before it's
# treated as failed.
HOSTPULSE_COMMAND_TIMEOUT=120

# ---------------------------------------------------------------------------
# Users excluded from resource monitoring
# ---------------------------------------------------------------------------
# ADDED on top of a built-in default set of system/service accounts already
# excluded in hostpulse.py (root, mysql, apache, nginx, etc) -- you only
# need to list extra accounts specific to this server here, not the whole
# system-account list again.
HOSTPULSE_IGNORED_USERS=

# ---------------------------------------------------------------------------
# LVE fault thresholds (fault counts within the lveinfo period above)
# ---------------------------------------------------------------------------
HOSTPULSE_PMEMF_WARNING=15
HOSTPULSE_PMEMF_CRITICAL=30

HOSTPULSE_NPROCF_WARNING=15
HOSTPULSE_NPROCF_CRITICAL=30

HOSTPULSE_CPUF_WARNING=15
HOSTPULSE_CPUF_CRITICAL=30

HOSTPULSE_IOF_WARNING=15
HOSTPULSE_IOF_CRITICAL=30

HOSTPULSE_IOPSF_WARNING=15
HOSTPULSE_IOPSF_CRITICAL=30

# aCPU is the user's actual CPU usage from lveinfo (100 = 1 core). It is
# evaluated as a percentage of that user's own LVE CPU limit (lCPU), not
# against an absolute number -- 70/90 here means warning at 70% and
# critical at 90% of the user's lCPU. Users whose lCPU is unknown are
# treated as normal.
HOSTPULSE_ACPU_WARNING=70
HOSTPULSE_ACPU_CRITICAL=90

# ---------------------------------------------------------------------------
# Live process snapshot thresholds (single ps snapshot, not an average)
# ---------------------------------------------------------------------------
# Aggregate %CPU across all of a user's processes at the moment ps runs
# (instantaneous ps snapshot, outside of LVE accounting). 100 = 1 core.
# Like aCPU, it is evaluated as a percentage of the user's own LVE CPU
# limit (lCPU) -- 70/90 here means warning at 70% and critical at 90% of
# the user's lCPU. Users whose lCPU is unknown are treated as normal.
HOSTPULSE_CPU_WARNING=70
HOSTPULSE_CPU_CRITICAL=90

HOSTPULSE_NPROC_WARNING=15
HOSTPULSE_NPROC_CRITICAL=30

# Aggregate RSS memory across all of a user's processes, in MiB.
HOSTPULSE_RSS_WARNING=3072
HOSTPULSE_RSS_CRITICAL=4096

# ---------------------------------------------------------------------------
# Vhost traffic thresholds (per-domain requests, read from the LiteSpeed
# Prometheus exporter and summed per DirectAdmin owner) -- unvalidated
# starting guesses, tune per server.
# ---------------------------------------------------------------------------
# The exporter must already be installed and running (see
# https://github.com/litespeedtech/litespeed-prometheus-exporter). Point
# this at its /metrics endpoint -- 127.0.0.1 is correct if it runs on the
# same host as HostPulse, which is the normal setup.
HOSTPULSE_EXPORTER_URL=http://127.0.0.1:9936/metrics
HOSTPULSE_EXPORTER_TIMEOUT=15
# DirectAdmin's domain-to-user map (exim's domainowners file).
HOSTPULSE_DOMAIN_OWNERS_FILE=/etc/virtual/domainowners
# Where the collector stores the previous run's per-domain request totals
# so it can compute requests/minute as a delta between runs. Needs to
# persist between cron/timer runs -- don't point this at /tmp on a system
# that clears it.
HOSTPULSE_VHOST_STATE_FILE=/opt/hostpulse/state/vhost_traffic.json

HOSTPULSE_VHOST_REQPM_WARNING=1000
HOSTPULSE_VHOST_REQPM_CRITICAL=3000

HOSTPULSE_VHOST_REQPS_WARNING=50
HOSTPULSE_VHOST_REQPS_CRITICAL=120

# ---------------------------------------------------------------------------
# Scoring weights
# ---------------------------------------------------------------------------
# Used to rank flagged users against each other in the output (higher
# score = more urgent). A user's total score is the sum of the weights for
# every category (lve / process / memory / traffic / database / email)
# where at least one metric in that category crossed a warning or critical
# threshold. These values mirror WEIGHT_ENV_NAMES in hostpulse.py.
HOSTPULSE_LVE_WEIGHT=5
HOSTPULSE_PROCESS_WEIGHT=4
HOSTPULSE_MEMORY_WEIGHT=4
HOSTPULSE_TRAFFIC_WEIGHT=3

# ---------------------------------------------------------------------------
# LVE Database stats thresholds (/var/lve/lvestats2.db)
# ---------------------------------------------------------------------------
HOSTPULSE_LVE_DB_PATH=/var/lve/lvestats2.db

HOSTPULSE_DB_PEAK_CPU_WARNING=150
HOSTPULSE_DB_PEAK_CPU_CRITICAL=300

HOSTPULSE_DB_AVG_CPU_WARNING=100
HOSTPULSE_DB_AVG_CPU_CRITICAL=200

HOSTPULSE_DB_WRITE_MB_WARNING=10
HOSTPULSE_DB_WRITE_MB_CRITICAL=20

HOSTPULSE_DATABASE_WEIGHT=3

# ---------------------------------------------------------------------------
# DirectAdmin Email Usage collector (/etc/virtual/usage/$USERNAME)
# ---------------------------------------------------------------------------
HOSTPULSE_EMAIL_USAGE_PATH=/etc/virtual/usage

# Leave blank to use hostname-based auto limit (2000 for mailservice*, 200 for others)
# Or define custom values here to override auto calculation:
# HOSTPULSE_EMAIL_WARNING=160
# HOSTPULSE_EMAIL_CRITICAL=200

HOSTPULSE_EMAIL_WEIGHT=2
